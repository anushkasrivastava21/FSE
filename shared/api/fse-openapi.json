        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Get cached NGO demand orders with optional filters",
        "tags": [
          "Orders"
        ]
      },
      "post": {
        "description": "Returns encoded calldata and the Order contract address for the NGO frontend wallet to sign and broadcast.",
        "operationId": "OrderController_preparePlaceOrderTransaction",
        "parameters": [],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Prepare an unsigned placeOrder transaction",
        "tags": [
          "Orders"
        ]
      }
    },
    "/orders/{id}": {
      "get": {
        "operationId": "OrderController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "On-chain order ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Get a single order by on-chain order ID",
        "tags": [
          "Orders"
        ]
      }
    },
    "/orders/{id}/cancel": {
      "post": {
        "description": "Returns encoded calldata for the NGO wallet to sign and broadcast.",
        "operationId": "OrderController_prepareCancelOrderTransaction",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "On-chain order ID",
            "schema": {
              "type": "string"
