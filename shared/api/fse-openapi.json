    "/handoffs": {
      "get": {
        "operationId": "HandoffController_findAll",
        "parameters": [
          {
            "name": "matchId",
            "required": false,
            "in": "query",
            "description": "Filter by match ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "stage",
            "required": false,
            "in": "query",
            "description": "0 = PickedUp, 1 = InTransit, 2 = Delivered",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Get cached custody handoffs",
        "tags": [
          "Handoffs"
        ]
      },
      "post": {
        "description": "Returns encoded calldata for the caller's wallet to sign and broadcast.",
        "operationId": "HandoffController_prepareRecordHandoffTransaction",
        "parameters": [],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Prepare an unsigned recordHandoff transaction",
        "tags": [
          "Handoffs"
        ]
      }
