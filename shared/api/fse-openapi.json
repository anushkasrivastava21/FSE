            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Get complete custody trail for a match",
        "tags": [
          "Handoffs"
        ]
      }
    },
    "/tokens/{donorAddress}": {
      "get": {
        "operationId": "TokenController_findByDonorAddress",
        "parameters": [
          {
            "name": "donorAddress",
            "required": true,
            "in": "path",
            "description": "Donor wallet address",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Get Food Credit Tokens for a donor",
        "tags": [
          "Food Credit Tokens"
        ]
      }
    },
    "/tokens/match/{matchId}": {
      "get": {
        "operationId": "TokenController_findByMatchId",
        "parameters": [
          {
            "name": "matchId",
            "required": true,
            "in": "path",
            "description": "MatchingEngine match ID (bytes32)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Get Food Credit Tokens for a match",
        "tags": [
          "Food Credit Tokens"
        ]
