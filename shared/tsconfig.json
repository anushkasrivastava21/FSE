{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "sourceMap": false,
    "outDir": "./dist",
    "rootDir": "./",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["index.ts", "types/**/*"],
  "exclude": ["node_modules", "dist"]
}
