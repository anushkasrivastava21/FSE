# ── Smart Contracts ───────────────────────────────────────
PRIVATE_KEY=                          # deployer wallet private key (testnet only)
AMOY_RPC_URL=                         # Polygon Amoy RPC (e.g. from Alchemy/Infura)
POLYGONSCAN_API_KEY=                  # for contract verification on Polygonscan

# ── Backend ───────────────────────────────────────────────
DATABASE_URL=                         # Supabase or local Postgres connection string
REDIS_URL=                            # BullMQ/Redis URL
PINATA_JWT=                           # Pinata API JWT for IPFS uploads
CONTRACT_ADDRESSES_PATH=./deployments/testnet.json   # auto-generated, do not edit manually
JWT_SECRET=                           # backend auth secret

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=                  # backend base URL
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID= # from cloud.walletconnect.com
NEXT_PUBLIC_CHAIN_ID=80002            # Polygon Amoy chainId — do not change
