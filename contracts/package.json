    "@types/chai": "4.3.0",
    "chai": "4.3.0",
    "dotenv": "^17.4.2",
    "hardhat": "^2.22.0",
    "solhint": "^5.0.0",
    "ts-node": "^10.9.0",
    "typechain": "^8.3.0",
    "typescript": "^5.4.0"
